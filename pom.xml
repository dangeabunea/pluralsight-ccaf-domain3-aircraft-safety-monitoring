<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.atcsafety</groupId>
    <artifactId>atc-safety-monitoring</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>atc-safety-monitoring</name>
    <description>ATC Safety Monitoring System — root reactor</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ArchUnit — executable architecture rules enforced at mvn test time -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>1.3.0</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- atcsafety-contracts MUST be listed first: downstream modules depend on it -->
    <modules>
        <module>backend/atcsafety-contracts</module>
        <module>backend/radar-data-processing</module>
        <module>backend/separation-infringement-detection</module>
        <module>backend/rest-api</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <!-- PMD 7.x static analysis — Java 21 compatible (records, sealed classes,
                     pattern matching). Invoked explicitly via mvn pmd:check pmd:cpd-check;
                     not bound to a lifecycle phase to preserve mvn test speed during TDD. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>3.28.0</version>
                    <configuration>
                        <rulesets>
                            <ruleset>${maven.multiModuleProjectDirectory}/pmd-ruleset.xml</ruleset>
                        </rulesets>
                        <targetJdk>21</targetJdk>
                        <failOnViolation>true</failOnViolation>
                        <printFailingErrors>true</printFailingErrors>
                        <!-- CPD: minimum duplicate token count before flagging -->
                        <minimumTokens>100</minimumTokens>
                        <excludeRoots>
                            <!-- Generated sources have no maintainability value from PMD -->
                            <excludeRoot>target/generated-sources</excludeRoot>
                            <!-- Test sources excluded: ArchUnit + Claude Code Review already
                                 gate test quality; complexity rules produce false positives
                                 on legitimate arrange-act-assert helper methods -->
                            <excludeRoot>src/test/java</excludeRoot>
                        </excludeRoots>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
