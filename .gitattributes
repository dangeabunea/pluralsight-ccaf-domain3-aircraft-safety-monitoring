# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Explicitly declare text files
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.sh text eol=lf

# Binary files - do not modify
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.pdf binary
*.pptx binary
*.docx binary
